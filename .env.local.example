# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI SDK (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-generative-ai-key"
